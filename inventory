  {min:0, max:5, palette:['white','yellow','orange','red','800000']},
  'Flood frequency (1=yellow → 5=dark red)');

// Verify merged area
var invArea = floodInventory.toFloat().multiply(ee.Image.pixelArea())
  .reduceRegion({reducer: ee.Reducer.sum(), geometry: roi,
                 scale: 100, maxPixels: 1e10, bestEffort: true});
print('Total merged flood area (km²):',
  ee.Number(invArea.get('flood')).divide(1e6).round());

// Per-event area for verification
var events = {
  '2017': flood2017, '2019': flood2019, '2021': flood2021,
  '2022': flood2022, '2024': flood2024
};
Object.keys(events).forEach(function(yr) {
  var a = events[yr].toFloat().multiply(ee.Image.pixelArea())
    .reduceRegion({reducer: ee.Reducer.sum(), geometry: roi,
                   scale: 100, maxPixels: 1e10, bestEffort: true});
  print(yr + ' area (km²):',
    ee.Number(a.get('flood')).divide(1e6).round());
});


// ══════════════════════════════════════════════════════════════
// SAMPLE POINTS — FIX 3: scale=30 instead of scale=10
//
// WHY scale=30:
// At scale=10 over an 8,509 km² ROI, GEE must consider
// ~85 million pixels for sampling — hits memory limit
// silently returns far fewer points than requested.
// At scale=30 the grid has ~9.5 million pixels — manageable.
// Sample point coordinates are still precise lat/lon.
// Scale=30 matches the 30m sampling standard used in
// Khan et al. (2026) for the same Kosi Megafan study area.
// ══════════════════════════════════════════════════════════════

var N = 6000;

// Flood sample points
var floodPoints = floodInventory
  .updateMask(floodInventory.eq(1))
  .sample({
    region:    roi,
    scale:     30,       // FIX: was 10, now 30
    numPixels: N,
    seed:      42,
    geometries: true
  })
  .map(function(f){ return f.set('label', 1); });

// Non-flood sample points
// Sampled from flat Terai only — same constraint as flood pixels
var nonFloodMask = floodInventory.eq(0)
  .multiply(permWater.not())
  .multiply(elevMask)
  .selfMask();

var nonFloodPoints = nonFloodMask
  .sample({
    region:    roi,
    scale:     30,       // FIX: was 10, now 30
    numPixels: N,
    seed:      42,
    geometries: true
  })
  .map(function(f){ return f.set('label', 0); });

var allPoints = floodPoints.merge(nonFloodPoints);

print('── SAMPLE POINT COUNTS ──');
print('Flood points:', floodPoints.size());
print('Non-flood points:', nonFloodPoints.size());
print('Total:', allPoints.size());

// Visualise points
Map.addLayer(floodPoints,    {color: 'FF0000'}, 'Flood points (red)');
Map.addLayer(nonFloodPoints, {color: '0000FF'}, 'Non-flood points (blue)');


